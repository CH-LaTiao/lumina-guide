# Copy values into your shell or process manager. Never commit real secrets.
LUMINA_SERIAL=YOUR_DEVICE_SERIAL
LUMINA_YOLO_MODEL=/home/your-user/ultralytics/ultralytics/yolo11n.onnx
LUMINA_SDK_PYTHON=/home/your-user/lumina-sdk-env/bin/python
LUMINA_FRAME_SOURCE=shm
LUMINA_ORBBEC_EXTENSIONS=/home/your-user/orbbec-sdk/<sdk-dir>/lib/extensions
# Origin only: no /compatible-mode/v1 suffix. Override privately for a dedicated workspace.
LUMINA_API_HOST=https://dashscope.aliyuncs.com
ONLINE_MODEL=qwen3.8-flash
ASR_MODEL=qwen3-asr-flash
# DASHSCOPE_API_KEY is intentionally not stored here.
